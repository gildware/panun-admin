            $('#leadCustomerModal').on('change', '[name="service_subcategory"]', function () {
                if (window._customerModalPrefilling) return;
                loadServices();
            });
            $('#leadCustomerModal').on('change', '[name="service_name"]', function () {
                if (window._customerModalPrefilling) return;
                loadVariants();
            });
        })();

